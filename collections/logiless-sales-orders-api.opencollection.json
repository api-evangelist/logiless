{
  "opencollection": "1.0.0",
  "info": {
    "name": "LOGILESS Articles Sales Orders API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://app2.logiless.com/oauth/v2/auth",
      "accessTokenUrl": "https://app2.logiless.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Sales Orders",
        "type": "folder"
      },
      "items": [
