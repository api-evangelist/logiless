{
  "opencollection": "1.0.0",
  "info": {
    "name": "LOGILESS Articles Suppliers API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://app2.logiless.com/oauth/v2/auth",
      "accessTokenUrl": "https://app2.logiless.com/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Suppliers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List suppliers (仕入先マスタの一覧を取得)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app2.logiless.com/api/v1/merchant/:merchant_id/suppliers",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "Merchant identifier the token is scoped to"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results to return. Default 20, maximum 500."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number. Default 1."
              }
            ]
          },
          "docs": "List suppliers (仕入先マスタの一覧を取得)"
        },
        {
          "info": {
            "name": "Create a supplier",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app2.logiless.com/api/v1/merchant/:merchant_id/suppliers/new",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "Merchant identifier the token is scoped to"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a supplier"
        },
        {
          "info": {
            "name": "Update a supplier",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app2.logiless.com/api/v1/merchant/:merchant_id/suppliers/:id",
            "params": [
              {
                "name": "merchant_id",
                "value": "",
                "type": "path",
                "description": "Merchant identifier the token is scoped to"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a supplier"
        }
      ]
    }
  ],
  "bundled": true
}